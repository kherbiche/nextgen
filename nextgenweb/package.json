{
  "name": "nextgenweb",
  "version": "1.0.0",
  "config": {
    "app_folder": "../nextGeneration/target/nextGeneration/js/app_v2/",
    "assets_i18n_folder": "../nextGeneration/target/nextGeneration/js/app_v2/assets/i18n",
    "assets_data_folder": "../nextGeneration/target/nextGeneration/js/app_v2/assets/data/gestionNotification"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build",
    "build-dev": "rimraf \"$npm_package_config_app_folder\" && npm run build && npm run deploy_app && npm run deploy_assets",
    "deploy_app": "mkdirp \"$npm_package_config_app_folder\" && cpx -v -f \"./dist/*.js\" \"$npm_package_config_app_folder\" ",
    "deploy_assets": "mkdirp \"$npm_package_config_assets_i18n_folder\" && mkdirp \"$npm_package_config_assets_data_folder\" && cpx -v -f \"./dist/assets/i18n/*.json\" \"$npm_package_config_assets_i18n_folder\" && cpx -v -f \"./dist/assets/data/gestionNotification/*.json\" \"$npm_package_config_assets_data_folder\" "
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.14",
    "@angular/common": "21.2.14",
    "@angular/compiler": "21.2.14",
    "@angular/core": "21.2.14",
    "@angular/forms": "21.2.14",
    "@angular/localize": "21.2.14",
    "@angular/cdk": "21.2.12",
    "@angular/material": "21.2.12",
    "@angular/platform-browser": "21.2.14",
    "@angular/platform-browser-dynamic": "21.2.14",
    "@angular/platform-server": "21.2.14",
    "@angular/router": "21.2.14",
    "@ngx-translate/core": "17.0.0",
    "@ngx-translate/http-loader": "17.0.0",
    "@ngxs/devtools-plugin": "21.0.0",
    "@ngxs/form-plugin": "21.0.0",
    "@ngxs/logger-plugin": "21.0.0",
    "@ngxs/storage-plugin": "21.0.0",
    "@ngxs/store": "21.0.0",
    "chart.js": "4.5.1",
    "chartjs-plugin-datalabels": "2.2.0",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "ng-http-loader": "19.0.0",
    "ngx-mask": "21.0.1",
    "@euro-ombudsman/ngx-modal-dialog": "21.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.12",
    "@angular/cli": "21.2.12",
    "@angular/compiler-cli": "21.2.14",
    "@types/lodash": "4.17.24",
    "@types/node": "22.15.29",
    "cpx2": "8.0.2",
    "mkdirp": "3.0.1",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  },
  "peerDependencies": {},
  "overrides": {}
}